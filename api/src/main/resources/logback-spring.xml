<?xml version="1.0" encoding="UTF-8"?>
<!--
  Two streams (BoK 5.2.3 C):
  - the application log, structured JSON (Elastic Common Schema) on stdout;
  - the audit stream, one canonical JSON object per line on stdout, marked "stream":"audit",
    which is also stored in the hash-chained audit table and forwarded to the collector.
  Docker keeps stdout with rotation (see docker-compose.yml), and a log shipper picks it up.
-->
<configuration>
    <include resource="org/springframework/boot/logging/logback/defaults.xml"/>

    <turboFilter class="nl.fontys.securedesk.config.ForbiddenLoggersFilter"/>

    <springProfile name="test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder>
                <pattern>%d{HH:mm:ss.SSS} %-5level %logger{36} - %msg%n</pattern>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>
    <springProfile name="!test">
        <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
            <encoder class="org.springframework.boot.logging.logback.StructuredLogEncoder">
                <format>ecs</format>
                <charset>UTF-8</charset>
            </encoder>
        </appender>
    </springProfile>

    <appender name="AUDIT_CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <logger name="AUDIT" level="INFO" additivity="false">
        <appender-ref ref="AUDIT_CONSOLE"/>
    </logger>

    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>
</configuration>
