# MySQL in the data zone (SC-06, SR-04).
[mysqld]
# Every connection is encrypted, TLS 1.3 only, with the internal CA's certificate.
require_secure_transport = ON
tls_version = TLSv1.3
ssl_ca = /run/secrets/tls/ca.crt
ssl_cert = /run/secrets/tls/mysql.crt
ssl_key = /run/secrets/tls/mysql.key

# UTC everywhere (BoK 5.3.4: trust the clock), utf8mb4 for all text.
default_time_zone = '+00:00'
character_set_server = utf8mb4
collation_server = utf8mb4_0900_ai_ci

# No file import or export from SQL, no reverse DNS lookups.
local_infile = 0
secure_file_priv = NULL
skip_name_resolve = ON
